# ── دیتابیس ──────────────────────────────────────────────
# توسعه: می‌توانید با `npm run db:server` سرور PGlite را اجرا کنید:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# تولید: آدرس PostgreSQL واقعی (مثلاً Neon / Supabase / RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── امنیت ────────────────────────────────────────────────
# رمز امضای توکن‌های سشن — حتماً یک رشته تصادفی طولانی بگذارید:
AUTH_SECRET=please-change-me-to-a-long-random-string

# ── آدرس عمومی سایت (برای sitemap و QR) ──────────────────
NEXT_PUBLIC_SITE_URL=https://kasbyab.ir

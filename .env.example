# ── اتصال PostgreSQL / Supabase ──────────────────────────
# از داشبورد Supabase > Connect، گزینه Transaction pooler یا Direct connection
# را کپی کنید و رمز را URL-encode کنید. این متغیر فقط سمت سرور استفاده می‌شود.
DATABASE_URL=postgresql://all:URL_ENCODED_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# این دو مقدار برای مستندات/اتصال‌های آینده‌ی Supabase هستند؛ کلید secret را
# هرگز در کد، مرورگر یا Git commit نگذارید.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# ── امنیت سشن‌ها ─────────────────────────────────────────
# یک مقدار تصادفی طولانی بسازید؛ در production حتماً تغییر کند.
AUTH_SECRET=replace-with-a-long-random-secret

# ── مدیر اولیه ───────────────────────────────────────────
# seed از این مقادیر استفاده می‌کند. اگر جدول admins خالی باشد، اولین ورود
# با همین دو متغیر، مدیرکل را به‌صورت خودکار می‌سازد.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── آدرس عمومی سایت (برای QR، sitemap و metadata) ────────
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── توسعه محلی اختیاری ───────────────────────────────────
# بدون DATABASE_URL در production برنامه عمداً عملیات نوشتن را متوقف می‌کند.
# برای توسعه می‌توانید `npm run db:server` را اجرا کنید و از این مقدار استفاده کنید:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

APP_NAME="کسب‌یاب"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database: PostgreSQL + PostGIS ─────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kasbyab
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Redis (cache / queue / session / rate-limit) ───────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# در محیط توسعه سبک (بدون Redis) این سه را file/sync/database بگذارید:
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# SESSION_DRIVER=file

# ── CORS / FRONTEND ────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ── OTP / SMS ──────────────────────────────────────────
# درایورهای پیامک: log | kavenegar | ghasedak | smsir
SMS_DRIVER=log
# در حالت توسعه کد OTP در پاسخ API برگردانده می‌شود (فقط SMS_FAKE_MODE=true)
SMS_FAKE_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
KAVENEGAR_API_KEY=
GHASEDAK_API_KEY=
SMSIR_API_KEY=

# ── KasbYab ────────────────────────────────────────────
KASBYAB_DEFAULT_RADIUS_M=3000
KASBYAB_MAX_RADIUS_M=50000
KASBYAB_SEARCH_LIMIT=50
